# Copy to project root as `.env.local` (gitignored), then fill in values from
# Supabase → Project Settings → API.
#
# URL: Project Settings → General (or Connect) → Project URL
# Key: either Legacy anon (`eyJ...`) OR Publishable key (`sb_publishable_...`)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Use one of the following:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
